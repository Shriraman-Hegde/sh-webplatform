{
  "name": "@sh-webplatform/webkit",
  "version": "0.1.0",
  "description": "Shared Lit UI library (webkit) for sh-webplatform — open-wc toolchain",
  "type": "module",
  "main": "./dist/webkit.esm.js",
  "module": "./dist/webkit.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/webkit.esm.js"
    },
    "./cdn": "./dist/webkit.cdn.min.js",
    "./themes.css": "./dist/themes.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "./src/**/*.ts"
  ],
  "scripts": {
    "analyze": "echo \"custom-elements.json: add CEM when component set stabilizes\"",
    "start": "web-dev-server --config web-dev-server.config.mjs",
    "build": "rimraf dist tsc-out && tsc -p tsconfig.json && rollup -c rollup.config.mjs && node ./scripts/copy-themes.mjs",
    "test": "web-test-runner --config web-test-runner.config.mjs",
    "test:watch": "web-test-runner --config web-test-runner.config.mjs --watch",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "peerDependencies": {
    "lit": "^3.2.0",
    "@lit/context": "^1.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@open-wc/building-rollup": "^3.0.2",
    "@open-wc/testing": "^5.0.0",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-links": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/web-components": "^8.4.7",
    "@storybook/web-components-vite": "^8.4.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@web/dev-server": "^1.0.1",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/test-runner": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "lit": "^3.2.1",
    "playwright": "^1.65.1",
    "rimraf": "^6.1.4",
    "rollup": "^3.30.0",
    "storybook": "^8.4.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lit/context": "^1.1.6"
  }
}
